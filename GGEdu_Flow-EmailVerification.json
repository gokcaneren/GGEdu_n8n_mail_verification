    {
      "parameters": {
        "jsCode": "const webhookData = $('Webhook').first().json.body;\nconst template = $('Select Email Info').first().json; // ← Postgres node adını yaz\n\nlet html = template.HtmlBody\n  .replace(/{{FirstName}}/g, webhookData.FirstName)\n  .replace(/{{VerifyUrl}}/g, `http://localhost:5292/api/auth/verify?token=${webhookData.Token}`);\n\nreturn [{\n  json: {\n    to: webhookData.Email,\n    subject: template.Subject,\n    html,\n  }\n}];"
      },
