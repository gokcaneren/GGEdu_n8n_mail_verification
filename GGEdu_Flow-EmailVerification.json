    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \"Subject\", \"HtmlBody\"\nFROM \"EmailTemplates\"\nWHERE \"TemplateKey\" = '{{ $json.body.TemplateKey }}'\nAND \"Locale\" = '{{ $json.body.Locale }}'\nLIMIT 1",
