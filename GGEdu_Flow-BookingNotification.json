        "jsCode": "const webhookData = $('Webhook').first().json.body;\n\nconst formatDate = (dateStr, locale) => {\n  return new Date(dateStr).toLocaleString(\n    locale === 'tr' ? 'tr-TR' : 'en-GB',\n    { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }\n  );\n};\n\nconst meetingUrl = `https://meet.jit.si/GGEdu-${webhookData.BookingId}`;\n\n// Öğretmen emaili\nconst teacherTemplate = $('Postgres - Teacher Template').first().json;\nconst teacherHtml = teacherTemplate.HtmlBody\n  .replace(/{{RecipientFirstName}}/g, webhookData.TeacherFirstName)\n  .replace(/{{OtherPartyFirstName}}/g, webhookData.StudentFirstName)\n  .replace(/{{CourseName}}/g, webhookData.CourseName)\n  .replace(/{{FormattedStart}}/g, formatDate(webhookData.CourseStartDate, webhookData.Locale))\n  .replace(/{{FormattedEnd}}/g, formatDate(webhookData.CourseEndDate, webhookData.Locale))\n  .replace(/{{MeetingUrl}}/g, meetingUrl);\n\nreturn {\n  json: {\n      to: webhookData.TeacherEmail,\n      subject: teacherTemplate.Subject,\n      html: teacherHtml,\n    }\n};"
